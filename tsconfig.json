{
  "compilerOptions": {
    "target": "es2018",
    "module": "ESNext",        // Changed from "CommonJS" to "ESNext"
    "moduleResolution": "node",  // Add this line
    "outDir": "./",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "lib": ["DOM", "ES6", "ES2018"],  // Add this line
    //"ignoreDeprecations": "6.0"  // Silence deprecation warnings
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/combined.ts"]
}
